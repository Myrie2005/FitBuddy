model Workout {
  id              String   @id @default(uuid(7))
  title           String
  description     String?
  category        Category
  level           Level    @default(ALL)
  /// Free-text address, e.g. "גן סאקר, ירושלים"
  location        String
  /// Coordinates for the map and the weather forecast (optional).
  lat             Float?
  lng             Float?
  /// Optional Waze link to the meeting point. If empty, the client builds one from `location`.
  wazeUrl         String?
  startTime       DateTime
  maxParticipants Int
  /// Price in shekels. 0 = free.
  cost            Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creatorId     String
  creator       User           @relation("WorkoutCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  registrations Registration[]
  reports       Report[]

  @@index([startTime])
  @@index([category])
}

model Registration {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  // A user can register to the same workout only once.
  @@unique([userId, workoutId])
  @@index([workoutId])
}
