# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string of the Neon **development** branch (Neon: Connect -> Branch: development).
# Never put the production URL here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require"

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

PORT=3000

# Allowed client origins, comma-separated. Leave empty in development to allow all.
CLIENT_ORIGIN=""

# Database for `npm test` - the Neon **test** branch (Neon: Branches -> create "test" -> Connect).
# Tests delete all data on every run. Never use the development or production URL here.
TEST_DATABASE_URL=""
